<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderMind App</title>
    <link rel="icon" href="/images/transparent-black-border-map-marker-with-plane-flying-over-1710972155974.webp" type="image/x-icon">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script> 

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- GSAP Animation Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
</head>
<body class="flex flex-col items-center justify-center min-h-screen py-8 font-sans bg-gray-800 text-yellow-400"> 

    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-10 w-full bg-white bg-opacity-80 shadow-lg backdrop-blur-md text-black">
        <div class="container mx-auto flex items-center justify-between px-4 py-3">
            <!-- Logo -->
            <a href="/" class="flex items-center space-x-3">
                <img src="https://cdn-icons-png.flaticon.com/128/826/826070.png" alt="Travel Icon" class="w-10 h-10">
                <span class="text-2xl font-bold text-gray-800">WanderMind</span>
            </a>
    
            <!-- Hamburger Menu (Visible on Small Screens) -->
            <button id="menu-btn" class="block md:hidden text-gray-800 focus:outline-none">
                <i class="fa-solid fa-bars text-2xl"></i>
            </button>
    
            <!-- Navigation Links (Hidden on Mobile, Shown on Larger Screens) -->
            <div id="menu" class="hidden md:flex flex-col md:flex-row md:items-center absolute md:static top-16 left-0 w-full md:w-auto bg-white md:bg-transparent shadow-md md:shadow-none p-4 md:p-0">
                <a href="/index" class="flex items-center text-gray-800 hover:text-blue-600 font-bold py-2 md:py-0 px-4 md:px-2">
                    <i data-lucide="home" class="w-6 h-6 mr-1 text-green-500"></i> Home
                </a>
                <a href="/profile" class="flex items-center text-gray-800 hover:text-blue-600 font-bold py-2 md:py-0 px-4 md:px-2">
                    <i data-lucide="user" class="w-6 h-6 mr-1 text-blue-500"></i> Profile
                </a>
                <a href="/edit-profile" class="flex items-center text-gray-800 hover:text-blue-600 font-bold py-2 md:py-0 px-4 md:px-2">
                    <i data-lucide="settings" class="w-6 h-6 mr-1 text-gray-600"></i> Settings
                </a>
                <a href="#" onclick="confirmLogout(event)" class="flex items-center px-4 py-2 mt-2 md:mt-0 bg-red-500 text-white rounded-full shadow-md hover:bg-red-600 transition duration-300">
                    <i class="fa-solid fa-sign-out-alt mr-2"></i> Logout
                </a>
            </div>
        </div>
    </nav>


    <!-- Profile Container -->
    <div class="flex flex-col items-center justify-center w-full h-full mt-24">
        <div class="w-full max-w-3xl p-8 bg-gray-800 border border-yellow-400 shadow-xl rounded-2xl text-yellow-400">

            <!-- Avatar Selection -->
            <div class="flex justify-center">
                <img id="avatar" class="w-24 h-24 rounded-full shadow-lg border-4 border-yellow-400" alt="User Avatar">
            </div>

            <!-- Profile Heading -->
            <h1 class="mt-4 text-3xl font-bold text-center">
                <span class="text-white"><%= user.username %>'s</span> Profile
            </h1>

            <!-- User Details -->
            <div class="mt-6 space-y-4">
                <div class="flex items-center p-4 bg-gray-700 rounded-lg shadow hover:bg-gray-600 transition">
                    <i data-lucide="mail" class="w-6 h-6 mr-2 text-yellow-400"></i>
                    <p class="text-lg font-medium"><strong>Email:</strong> <%= user.email %></p>
                </div>
                <div class="flex items-center p-4 bg-gray-700 rounded-lg shadow hover:bg-gray-600 transition">
                    <i data-lucide="phone" class="w-6 h-6 mr-2 text-yellow-400"></i>
                    <p class="text-lg font-medium"><strong>Phone:</strong> <%= user.phone %></p>
                </div>
                <div class="flex items-center p-4 bg-gray-700 rounded-lg shadow hover:bg-gray-600 transition">
                    <i data-lucide="map-pin" class="w-6 h-6 mr-2 text-yellow-400"></i>
                    <p class="text-lg font-medium"><strong>Location:</strong> <%= user.location %></p>
                </div>
                <div class="flex items-center p-4 bg-gray-700 rounded-lg shadow hover:bg-gray-600 transition">
                    <i data-lucide="user-check" class="w-6 h-6 mr-2 text-yellow-400"></i>
                    <p class="text-lg font-medium"><strong>Gender:</strong> <%= user.gender %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript Initialization -->
    <script>
        // Ensure Lucide icons render
        document.addEventListener("DOMContentLoaded", function() {
            lucide.createIcons();
        });
    
        // Get user gender from server-side variable
        const gender = "<%= user.gender %>".toLowerCase(); 
    
        // Avatar selection based on gender
        const avatar = document.getElementById("avatar");
    
        if (gender === "male") {
            avatar.src = "https://t3.ftcdn.net/jpg/05/66/32/22/360_F_566322207_Fa1DSykWMr5IjvNFFdgKapoCHJn36RgV.jpg";
        } else if (gender === "female") {
            avatar.src = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQy5DArtJPk5QAR5PqYEij1TsaCHCHMEkdKfA&s";
        } else {
            avatar.src = "https://cdn-icons-png.flaticon.com/512/1998/1998622.png";
        }
        function confirmLogout(event) {
        event.preventDefault(); // Prevent immediate navigation
        const confirmAction = confirm("Are you sure you want to logout?");
        if (confirmAction) {
            window.location.href = "/about"; // Replace with actual logout route
        }
    }
    const menuBtn = document.getElementById('menu-btn');
    const menu = document.getElementById('menu');

    menuBtn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
    });
    </script>

</body>
</html>
