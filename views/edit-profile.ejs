<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderMind App</title>
    <link rel="icon" href="/images/transparent-black-border-map-marker-with-plane-flying-over-1710972155974.webp" type="image/x-icon">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script> 
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- GSAP Animation Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
</head>
<body class="flex flex-col items-center justify-center min-h-screen py-8 font-sans bg-gray-900 text-gray-100">

    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-10 w-full bg-white bg-opacity-80 shadow-lg backdrop-blur-md text-black">
        <div class="container mx-auto flex items-center justify-between px-4 py-3">
            <!-- Logo -->
            <a href="/" class="flex items-center space-x-3">
                <img src="https://cdn-icons-png.flaticon.com/128/826/826070.png" alt="Travel Icon" class="w-10 h-10">
                <span class="text-2xl font-bold text-gray-800">WanderMind</span>
            </a>
    
            <!-- Hamburger Menu (Visible on Small Screens) -->
            <button id="menu-btn" class="block md:hidden text-gray-800 focus:outline-none">
                <i class="fa-solid fa-bars text-2xl"></i>
            </button>
    
            <!-- Navigation Links (Hidden on Mobile, Shown on Larger Screens) -->
            <div id="menu" class="hidden md:flex flex-col md:flex-row md:items-center absolute md:static top-16 left-0 w-full md:w-auto bg-white md:bg-transparent shadow-md md:shadow-none p-4 md:p-0">
                <a href="/index" class="flex items-center text-gray-800 hover:text-blue-600 font-bold py-2 md:py-0 px-4 md:px-2">
                    <i data-lucide="home" class="w-6 h-6 mr-1 text-green-500"></i> Home
                </a>
                <a href="/profile" class="flex items-center text-gray-800 hover:text-blue-600 font-bold py-2 md:py-0 px-4 md:px-2">
                    <i data-lucide="user" class="w-6 h-6 mr-1 text-blue-500"></i> Profile
                </a>
                <a href="/edit-profile" class="flex items-center text-gray-800 hover:text-blue-600 font-bold py-2 md:py-0 px-4 md:px-2">
                    <i data-lucide="settings" class="w-6 h-6 mr-1 text-gray-600"></i> Settings
                </a>
                <% if (user && user.role === 'admin') { %>
                    <a href="/admin/users" class="flex items-center text-gray-800 hover:text-blue-600 font-bold py-2 md:py-0 px-4 md:px-2">
                        <i data-lucide="scroll-text" class="w-6 h-6 mr-1 text-orange-600"></i>User List
                    </a>
                <% } %>
                <a href="#" onclick="confirmLogout(event)" class="flex items-center px-4 py-2 mt-2 md:mt-0 bg-red-500 text-white rounded-full shadow-md hover:bg-red-600 transition duration-300">
                    <i class="fa-solid fa-sign-out-alt mr-2"></i> Logout
                </a>
            </div>
        </div>
    </nav>

    
    <!-- Edit Profile container -->
    <div class="flex flex-col items-center justify-center w-full mt-16">
        <div class="w-full max-w-3xl p-8 bg-gray-800 border border-yellow-400 shadow-2xl rounded-2xl">
            <h1 class="mb-6 text-4xl font-bold text-center text-yellow-400 drop-shadow-lg">
                Edit Profile
            </h1>
            <form action="/edit-profile" method="POST" class="space-y-6">
                <div class="flex flex-col">
                    <label for="username" class="text-lg font-medium text-gray-300">Username:</label>
                    <input type="text" id="username" name="username" value="<%= user.username %>" required class="px-4 py-2 mt-2 bg-gray-700 text-white border border-yellow-400 rounded-lg focus:outline-none focus:border-yellow-400">
                </div>
                <div class="flex flex-col">
                    <label for="phone" class="text-lg font-medium text-gray-300">Phone:</label>
                    <input type="text" id="phone" name="phone" value="<%= user.phone %>" required class="px-4 py-2 mt-2 bg-gray-700 text-white border border-yellow-400 rounded-lg focus:outline-none focus:border-yellow-400">
                </div>
                <div class="flex flex-col">
                    <label for="location" class="text-lg font-medium text-gray-300">Location:</label>
                    <input type="text" id="location" name="location" value="<%= user.location %>" required class="px-4 py-2 mt-2 bg-gray-700 text-white border border-yellow-400 rounded-lg focus:outline-none focus:border-yellow-400">
                </div>
                <div class="flex flex-col">
                    <label for="gender" class="text-lg font-medium text-gray-300">Gender:</label>
                    <select name="gender" id="gender" required class="px-4 py-2 mt-2 bg-gray-700 text-white border border-yellow-400 rounded-lg focus:outline-none focus:border-yellow-400">
                        <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
                        <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
                        <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
                    </select>
                </div>
                <div class="flex flex-col">
                    <label for="email" class="text-lg font-medium text-gray-400">Email:</label>
                    <input type="text" id="email" value="<%= user.email %>" disabled class="px-4 py-2 mt-2 bg-gray-700 text-gray-400 border border-yellow-400 rounded-lg cursor-not-allowed">
                </div>
                <div class="flex flex-col">
                    <label for="role" class="text-lg font-medium text-gray-400">Role:</label>
                    <input type="text" id="role" value="<%= user.role %>" disabled class="px-4 py-2 mt-2 bg-gray-700 text-gray-400 border border-yellow-400 rounded-lg cursor-not-allowed">
                </div>
                <div class="flex justify-center">
                    <button type="submit" class="px-6 py-3 font-semibold text-black bg-yellow-400 rounded-xl hover:bg-yellow-500 transition">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        lucide.createIcons();
        function confirmLogout(event) {
        event.preventDefault(); // Prevent immediate navigation
        const confirmAction = confirm("Are you sure you want to logout?");
        if (confirmAction) {
            window.location.href = "/about"; // Replace with actual logout route
        }
    }
    const menuBtn = document.getElementById('menu-btn');
    const menu = document.getElementById('menu');

    menuBtn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
    });
    </script>

</body>
</html> 