<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - User List</title>
    <link rel="icon" href="/images/transparent-black-border-map-marker-with-plane-flying-over-1710972155974.webp" type="image/x-icon">
    <!-- Tailwind CSS -->

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x" defer></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- FontAwesome for Logout Icon -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/js/all.min.js"></script>

    <!-- Meta Description for SEO -->
    <meta name="description" content="Admin panel displaying a list of users in the WanderMind platform.">

    <script>
        // Optimized search function
        // Modify searchUsers function to add suggestion dropdown
function searchUsers() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const suggestions = []; // Gather suggestions based on search term
    document.querySelectorAll('#userTable tbody tr').forEach(row => {
        const text = Array.from(row.children).map(td => td.innerText.toLowerCase()).join(' ');
        row.style.display = text.includes(searchTerm) ? '' : 'none';
        if (text.includes(searchTerm)) {
            // Collect suggestions here
        }
    });
    // Display suggestions dynamically
}


        // Ensure Lucide icons load
        document.addEventListener("DOMContentLoaded", function () {
            lucide.createIcons();
        });
        document.addEventListener("alpine:init", () => {
            Alpine.data("menu", () => ({
                menuOpen: false,
            }));
        });
    
        function confirmLogout(event) {
            event.preventDefault();
            if (confirm("Are you sure you want to logout?")) {
                window.location.href = "/about"; // Correct logout route
            }
        }
       
    window.onload = function () {
        const menuBtn = document.getElementById('menu-btn');
        const menu = document.getElementById('menu');

        menuBtn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
        });
    };
    

    </script>
</head>
<body class="flex flex-col items-center justify-center min-h-screen bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-gray-100 font-sans">

    <!-- Navbar -->
    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-10 w-full bg-white bg-opacity-80 shadow-lg backdrop-blur-md text-black">
        <div class="container mx-auto flex items-center justify-between px-4 py-3">
            <!-- Logo -->
            <a href="/" class="flex items-center space-x-3">
                <img src="https://cdn-icons-png.flaticon.com/128/826/826070.png" alt="Travel Icon" class="w-10 h-10">
                <span class="text-2xl font-bold text-gray-800">WanderMind</span>
            </a>
            <!-- Hamburger Menu (Visible on Small Screens) -->
            <button id="menu-btn" class="block md:hidden text-gray-800 focus:outline-none">
                <i class="fa-solid fa-bars text-2xl"></i>
            </button>
    
            <!-- Navigation Links (Hidden on Mobile, Shown on Larger Screens) -->
            <div id="menu" class="hidden md:flex flex-col md:flex-row md:items-center absolute md:static top-16 left-0 w-full md:w-auto bg-white md:bg-transparent shadow-md md:shadow-none p-4 md:p-0">
                <a href="/index" class="flex items-center text-gray-800 hover:text-blue-600 font-bold py-2 md:py-0 px-4 md:px-2">
                    <i data-lucide="home" class="w-6 h-6 mr-1 text-green-500"></i> Home
                </a>
                <a href="/profile" class="flex items-center text-gray-800 hover:text-blue-600 font-bold py-2 md:py-0 px-4 md:px-2">
                    <i data-lucide="user" class="w-6 h-6 mr-1 text-blue-500"></i> Profile
                </a>
                <a href="/edit-profile" class="flex items-center text-gray-800 hover:text-blue-600 font-bold py-2 md:py-0 px-4 md:px-2">
                    <i data-lucide="settings" class="w-6 h-6 mr-1 text-gray-600"></i> Settings
                </a>
                <a href="#" onclick="confirmLogout(event)" class="flex items-center px-4 py-2 mt-2 md:mt-0 bg-red-500 text-white rounded-full shadow-md hover:bg-red-600 transition duration-300">
                    <i class="fa-solid fa-sign-out-alt mr-2"></i> Logout
                </a>
            </div>
        </div>
    </nav>


    

    <!-- Main Content -->
    <div class="container px-6 py-16 mt-20">
        <h1 class="text-5xl font-extrabold text-center mb-8 text-yellow-400 drop-shadow-lg">Users List</h1>

        <!-- Search Input -->
        <div class="relative w-full max-w-md mx-auto">
            <input type="text" id="searchInput" oninput="searchUsers()" placeholder="🔍 Search users..."
                class="w-full p-4 rounded-lg bg-gray-700 text-white shadow-md border border-gray-600 
                       focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:bg-gray-900 transition-all duration-300">
        </div>

        <!-- Table Container (Responsive) -->
        <div class="overflow-x-auto bg-gray-800 rounded-lg shadow-xl mt-8">
            <table id="userTable" class="w-full border border-collapse text-gray-300">
                <thead class="bg-yellow-500 text-gray-900 text-lg">
                    <tr>
                        <th class="p-4">ID</th>
                        <th class="p-4">Username</th>
                        <th class="p-4">Email</th>
                        <th class="p-4">Location</th>
                        <th class="p-4">Mobile</th>
                        <th class="p-4">Gender</th>
                        <th class="p-4">Role</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-700 text-lg">
                    <% users.forEach(user => { %>
                    <tr class="odd:bg-gray-700 even:bg-gray-800">
                        <td class="p-4 text-center"><%= user.id %></td>
                        <td class="p-4 text-center"><%= user.username %></td>
                        <td class="p-4 text-center"><%= user.email %></td>
                        <td class="p-4 text-center"><%= user.location %></td>
                        <td class="p-4 text-center"><%= user.phone %></td>
                        <td class="p-4 text-center"><%= user.gender %></td>
                        <td class="p-4 text-center"><%= user.role %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
