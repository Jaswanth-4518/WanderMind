<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Image Search</title>
    <link rel="icon" href="/images/transparent-black-border-map-marker-with-plane-flying-over-1710972155974.webp" type="image/x-icon">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 flex flex-col items-center p-5">
    <input id="search-box" type="text" placeholder="Search images..." 
        class="border p-2 rounded-md w-80 shadow-md hidden">
    
    <button onclick="searchImages()" class="hidden bg-blue-500 text-white px-4 py-2 rounded mt-2">Search</button>
    
    <div id="error-message" class="text-red-500 mt-3 hidden"></div>
    <div id="results" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mt-5"></div>

    <script>
        async function fetchImages(query) {
            const API_KEY = "AIzaSyAtRsY09KBuaFOhBVgkqsTtn4bNbk-dSZU";
            const CX = "554f86c22c7734b34"; // Custom Search Engine ID
            const URL = `https://www.googleapis.com/customsearch/v1?q=${query}&cx=${CX}&searchType=image&key=${API_KEY}`;

            try {
                const res = await fetch(URL);
                const data = await res.json();

                if (data.error) {
                    if (data.error.code === 429) {
                        throw new Error("Quota exceeded: Image search limit reached (100 per day). Please try again later.");
                    } else {
                        throw new Error(data.error.message);
                    }
                }

                return data.items || [];
            } catch (error) {
                console.error("Error fetching images:", error);

                // Show error message
                const errorDiv = document.getElementById("error-message");
                errorDiv.textContent = error.message;
                errorDiv.classList.remove("hidden");

                return null; // Returning null so we can handle it in displayImages()
            }
        }

        function displayImages(images) {
    const resultsDiv = document.getElementById("results");
    resultsDiv.innerHTML = ""; // Clear previous results

    if (!images) return; // If null is returned, do not show "No images found"

    // Hide error message if images are successfully loaded
    document.getElementById("error-message").classList.add("hidden");

    if (images.length === 0) {
        resultsDiv.innerHTML = "<p class='text-gray-500'>No images found.</p>";
        return;
    }

    // Limit to only 3 images
    images.slice(0, 3).forEach(img => {
        const imgElement = document.createElement("img");
        imgElement.src = img.link;
        imgElement.alt = img.title;
        imgElement.classList = "rounded shadow-md w-full h-48 object-cover";
        resultsDiv.appendChild(imgElement);
    });
}

        async function searchImages() {
            const query = document.getElementById("search-box").value.trim();
            if (!query) return;

            history.pushState({}, "", `?q=${query}`);

            const images = await fetchImages(query);

            displayImages(images);
        }

        // Load images based on URL param
        const urlParams = new URLSearchParams(window.location.search);
        const queryParam = urlParams.get("q");
        if (queryParam) {
            document.getElementById("search-box").value = queryParam;
            searchImages();
        }
    </script>

</body>
</html>