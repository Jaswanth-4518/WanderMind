<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - WanderMind</title>
    <link rel="icon" href="/images/transparent-black-border-map-marker-with-plane-flying-over-1710972155974.webp" type="image/x-icon">
    <!-- Tailwind CSS & Animation Libraries -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/js/all.min.js" crossorigin="anonymous"></script>

    <style>
        body {
            background: url('https://watermark.lovepik.com/photo/40015/6871.jpg_wh1200.jpg') no-repeat center center fixed;
            background-size: cover;
            color: black;
        }

        .fade-out {
            animation: fadeOut 1s forwards;
        }

        @keyframes fadeOut {
            from {
                opacity: 1;
            }
            to {
                opacity: 0;
                display: none;
            }
        }
    </style>
</head>

<body class="flex flex-col items-center justify-center min-h-screen py-8 font-sans">
    
    <h1 id="title" class="mb-10 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 opacity-0 drop-shadow-xl animate-blink">
        WanderMind Assistant
    </h1>
    

    <div class="flex flex-col md:flex-row items-center justify-center w-full max-w-4xl gap-6 p-8 sm:p-6 relative z-10">
        <!-- Left Side: Welcome Box -->
        <div class="w-full md:w-1/2 flex flex-col items-center justify-center p-8 bg-white/20 shadow-2xl 
                    backdrop-blur-sm border border-white/30 rounded-3xl text-black text-center min-h-[450px]">
            <img src="https://thumbs.dreamstime.com/z/plan-your-trip-travel-banner-vacation-planning-time-to-industry-modern-technologies-booking-hotel-vector-68543502.jpg?w=768" 
                 alt="Travel Image" class="w-40 h-40 rounded-lg shadow-lg mb-4">
            <h1 class="text-4xl font-extrabold drop-shadow-lg tracking-wide animate-bounce">WanderMind</h1>
            <p class="mt-2 text-lg font-medium italic">"Your AI-powered travel companion!"</p>
        </div>

        <!-- Right Side: Login Form -->
        <div class="w-full md:w-1/2 flex flex-col items-center justify-center p-6 bg-white/20 shadow-2xl 
                    backdrop-blur-sm border border-white/30 rounded-3xl min-h-[450px]">
            <h2 class="text-4xl font-extrabold text-center text-black">Login</h2>
            
            
            
            
            <form action="/login" method="POST" class="w-full space-y-5">
                <!-- Email Input -->
                <div>
                    <label for="email" class="block text-lg font-extrabold text-black">E-mail</label>
                    <input type="email" name="email" id="email" 
                        class="w-full px-4 py-3 bg-white/40 border border-black/70 rounded-md text-black placeholder-gray-800 
                               focus:ring-2 focus:ring-blue-400 focus:outline-none backdrop-blur-md"
                        placeholder="youremail@example.com" required>
                </div>

                <!-- Password Input -->
                <div class="relative">
                    <label for="password" class="block text-lg font-extrabold text-black">Password</label>
                    <input type="password" name="password" id="password"
                        class="w-full px-4 py-3 bg-white/40 border border-black/70 rounded-md text-black placeholder-gray-800 
                               focus:ring-2 focus:ring-blue-400 focus:outline-none backdrop-blur-md pr-10"
                        placeholder="Enter your password" required>
                    <span class="absolute inset-y-0 right-4 top-7 flex items-center cursor-pointer" onclick="togglePassword()">
                        <i id="eye-icon" class="fa-solid fa-eye text-black"></i>
                    </span>
                </div>

                <!-- Forgot Password Link -->
                <div class="flex justify-end">
                    <a href="/forgot-password" 
                       class="text-md font-extrabold text-black hover:underline">
                        <i class="fas fa-key"></i> Forgot Password?
                    </a>
                </div>
                <% if (typeof error !== 'undefined' && error) { %>
                    <p class="mb-4 text-red-700 bg-white/70 px-4 py-2 rounded-lg text-center font-bold shadow-md">
                        <i class="fas fa-exclamation-triangle"></i> <%= error %>
                    </p>
                <% } %>
                <!-- Login Button -->
                <button type="submit"
                    class="w-full py-3 text-lg font-extrabold bg-green-500 text-black rounded-lg shadow-2xl 
                           hover:bg-green-700 hover:scale-105 transition-transform duration-300 focus:ring-4 
                           focus:ring-green-300 focus:outline-none backdrop-blur-md cursor-pointer">
                    Login
                </button>

            </form>

            <!-- Register Link -->
            <p class="mt-2 text-center text-black font-bold text-md">
                <span>Don't have an account?</span>
                <a href="/register" class="font-extrabold hover:underline text-gray-900 text-lg">Register here</a>
            </p>
        </div>
    </div>
   <!-- Back to Home Button -->
   <div class="mt-4 flex justify-center">
    <a href="/about" 
       class="px-7 py-3 text-lg font-bold text-white bg-gradient-to-r from-blue-500 to-teal-500 
              rounded-lg shadow-lg hover:shadow-xl hover:from-blue-600 hover:to-teal-600 
              transform hover:scale-105 transition-all duration-300 flex items-center gap-2">
        <i class="fas fa-arrow-left text-white text-xl"></i> Back to Home
    </a>
</div>


    <!-- JavaScript -->
    <script>
        function togglePassword() {
            let passwordField = document.getElementById('password');
            let eyeIcon = document.getElementById('eye-icon');
            passwordField.type = passwordField.type === 'password' ? 'text' : 'password';
            eyeIcon.classList.toggle('fa-eye');
            eyeIcon.classList.toggle('fa-eye-slash');
        }
        anime.timeline()
            .add({
                targets: '#title',
                opacity: [0, 1],
                translateY: [-50, 0],
                duration: 1000,
                easing: 'easeOutExpo'
            })
            .add({
                targets: '.w-full.md\\:w-1\\/2.flex.flex-col.items-center',
                opacity: [0, 1],
                scale: [0.8, 1],
                rotate: ['-5deg', '0deg'],
                duration: 800,
                easing: 'easeOutElastic(1, .8)'
            }, '-=500');
    </script>
</body>
</html>
